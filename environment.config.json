            "contextWindow": 131072,
            "supportsTools": true,
            "supportsStreaming": true,
            "category": "flagship",
            "description": "High-speed reasoning, 131k context, native tool use, optimal for NLQ and trading execution"
          },
          {
            "id": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
