          "marketResearch": "@cf/zai-org/glm-4.7-flash",
          "searchAgent": "@cf/zai-org/glm-4.7-flash"
        },
        "temperatureDefaults": {
          "deterministic": 0.0,
          "analytical": 0.2,
          "creative": 0.7
