{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-search-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "agent.openaimp.com", "custom_domain": true }],
  "assets": { "directory": "./dist/", "binding": "ASSETS", "run_worker_first": true },
  "ai": { "binding": "AI" },
  "durable_objects": { "bindings": [{ "name": "SEARCH_AGENT", "class_name": "SearchAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SearchAgent"] }],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "<YOUR_KV_NAMESPACE_ID>" },
    { "binding": "ETRADE_KV", "id": "<YOUR_KV_NAMESPACE_ID>" }
  ],
  "observability": { "enabled": true },
  "vars": { "AI_SEARCH_ENDPOINT": "https://f57a6011-bc38-4d64-856d-69ad4c90042a.search.ai.cloudflare.com", "APP_NAME": "AI Search Agent", "MAS_MAX_STEPS": "4", "AI_MODEL": "@cf/zai-org/glm-4.7-flash" }
}
