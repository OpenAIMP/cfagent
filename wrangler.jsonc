{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-search-agent",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-29",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [{ "pattern": "agent.openaimp.com", "custom_domain": true }],
  "assets": { "directory": "./dist/", "binding": "ASSETS", "run_worker_first": true },
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "SEARCH_AGENT", "class_name": "SearchAgent" },
      {
        "name": "OPTIONS_SCANNER_MCP",
        "class_name": "OptionsScannerMCP"
      },
      // PR #3 — x402 PaymentsAgent DO (ledger + budget guards)
      { "name": "PAYMENTS_AGENT", "class_name": "PaymentsAgent" },
      // PR #4 — ScheduledAgent DO (autonomous cron-driven goals)
      { "name": "SCHEDULED_AGENT", "class_name": "ScheduledAgent" },
      // Issue #261 — ScreenerAgent DO (one agent, one UI, E*TRADE-only)
      { "name": "SCREENER_AGENT", "class_name": "ScreenerAgent" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["SearchAgent"] },
    { "tag": "v2", "new_sqlite_classes": ["OptionsScannerMCP"] },
    // PR #3 + PR #4 — new SQLite DO classes
    { "tag": "v3", "new_sqlite_classes": ["PaymentsAgent", "ScheduledAgent"] },
    // Issue #261 — ScreenerAgent
    { "tag": "v4", "new_sqlite_classes": ["ScreenerAgent"] }
  ],
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "f169a71089264590baeef28f851ebfc5" },
    { "binding": "ETRADE_KV", "id": "f169a71089264590baeef28f851ebfc5" }
  ],
  "observability": { "enabled": true },
  "triggers": {
    "crons": [
      "0 13 * * 1-5",
      "0 3 * * *",
      // PR #4 — ScheduledAgent tick every 30 min
      "*/30 * * * *",
      // Issue #255 — nightly mas_messages retention pass (enforced in the
      // scheduled() handler; runs against the Orchestrator agent's SQLite)
      "0 4 * * *"
    ]
  },
  // PR #6 — Vectorize for VectorMemory
  "vectorize": [
    {
      "binding": "VECTOR_MEMORY",
      "index_name": "vector-memory"
    }
  ],
  "vars": {
    "AI_SEARCH_ENDPOINT": "https://f57a6011-bc38-4d64-856d-69ad4c90042a.search.ai.cloudflare.com",
    "APP_NAME": "AI Search Agent",
    "MAS_MAX_STEPS": "4",
    "AI_MODEL": "@cf/zai-org/glm-4.7-flash",
    "CF_WALLET_NETWORK": "base-sepolia",
    "CF_WALLET_FACILITATOR": "https://x402.org/facilitator",
    "_comment_wallet": "Set CF_WALLET_RECIPIENT via: wrangler secret put CF_WALLET_RECIPIENT"
  }
}
